# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Seed logins — used only by `npm run db:seed`
SEED_PLAYER_EMAIL=hardwig@empire.local
SEED_PLAYER_PASSWORD=
SEED_ADMIN_EMAIL=admin@empire.local
SEED_ADMIN_PASSWORD=

# OpenAI — server-only. IDs live only here, never in call sites or UI.
OPENAI_API_KEY=
# Director (chapter + main-mission planning). Defaults to STRATEGIC model if unset.
OPENAI_MODEL_DIRECTOR=gpt-5.6-sol
OPENAI_MODEL_STRATEGIC=gpt-5.6-sol
OPENAI_MODEL_BALANCED=gpt-5.6-terra
OPENAI_MODEL_ECONOMY=gpt-5.6-luna

# xAI Grok — server-only. Intimate (TRUST) chat sticky sessions.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# ElevenLabs — server-only. Nyx phone mode TTS (STT uses OPENAI_API_KEY).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=KHhGkD3nLOz1oKsM5ijG
ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional absolute remaining character budget that counts as "low" (else ~10% of limit).
# ELEVENLABS_LOW_CREDIT_CHARS=2000
# Optional phone STT model (default gpt-4o-mini-transcribe, falls back to whisper-1).
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# CARTO raster basemaps. Server reads CARTO_API_KEY or NEXT_PUBLIC_CARTO_API_KEY.
CARTO_API_KEY=
NEXT_PUBLIC_CARTO_API_KEY=

# Vercel Cron — Authorization: Bearer CRON_SECRET
CRON_SECRET=

# Optional — OpenArt session cookie for Nyx image-to-video outreach (locked still first)
OPENART_SESSION=
